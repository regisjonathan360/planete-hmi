# Site Configuration
NEXT_PUBLIC_SITE_URL=https://planete-hmi.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Clé service-role (serveur uniquement) — nouveau format "secret key" (sb_secret_...)
# ou ancien format "service_role key" (le code accepte les deux).
SUPABASE_SECRET_KEY=your_secret_key

# API Keys (if needed)
YOUTUBE_API_KEY=your_youtube_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Secrets serveur pour les routes cron / admin protégées par Bearer token
CRON_SECRET=your_cron_secret
ADMIN_SECRET=your_admin_secret

# Chiffrement AES-256-GCM des tokens TikTok (32 bytes, base64)
TIKTOK_TOKEN_ENCRYPTION_KEY=your_32_byte_base64_key

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX  # Google Analytics 4 Measurement ID
