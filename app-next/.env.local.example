# --- Supabase (local : valeurs fournies par `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=__cle_anon_locale__
# SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SECRET_KEY=__cle_service_role_locale__

# --- Secrets plateformes (SERVEUR UNIQUEMENT, laissés vides tant qu'aucun
#     accès officiel n'est configuré ; les adaptateurs restent en mode manuel) ---
YOUTUBE_API_KEY=
# Clé serveur Google Cloud restreinte à YouTube Data API v3.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
AUDIOMACK_HAITI_CHART_ENDPOINT=
# Variables supplémentaires Audiomack (SERVEUR UNIQUEMENT)
AUDIOMACK_API_BASE_URL=https://api.audiomack.com/v1
AUDIOMACK_COUNTRY=haiti
AUDIOMACK_CHART_PERIOD=weekly

# --- Admin (SERVEUR UNIQUEMENT) ---
ADMIN_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_STOREFRONT=ht
APPLE_CHART_TYPES=songs
APPLE_CHART_LIMIT=200
APPLE_WORLDWIDE_GENRE_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://planete-hmi.vercel.app/api/tiktok/callback
TIKTOK_TOKEN_ENCRYPTION_KEY=
TIKTOK_SYNC_MAX_PAGES=10
# Optionnel : URL de base de l'API TikTok v2 (défaut : https://open.tiktokapis.com/v2)
# TIKTOK_API_BASE_URL=https://open.tiktokapis.com/v2

# --- Cron (SERVEUR UNIQUEMENT) ---
# Secret partagé pour protéger les endpoints cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
